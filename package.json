    "lucide-react": "^1.27.0",
    "mobx": ">=6",
    "mobx-i18n": "^0.7.5",
    "mobx-react": ">=9",
    "mobx-react-helper": "^0.5.1",
    "mobx-restful": "^2.1.4",
    "next": "^16.2.12",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-utility": "^4.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@octokit/openapi-types": "^27.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash.debounce": "^4.0.9",
