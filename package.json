    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "mobx-github": "^0.7.0",
    "shadcn": "^4.16.0",
    "shadcn-helper": "^0.5.9",
